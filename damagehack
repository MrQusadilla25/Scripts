  menu.appendChild(closeButton);

  // === Styling ===
  function updateTheme() {
    const theme = themes[currentTheme];
    if (theme.bg === "rainbow") {
      menu.style.background = "linear-gradient(270deg, red, orange, yellow, green, blue, indigo, violet)";
      menu.style.backgroundSize = "1400% 1400%";
      menu.style.animation = "rainbow 10s ease infinite";
    } else {
      menu.style.background = theme.bg;
      menu.style.animation = "none";
    }
    menu.style.color = theme.text;
    menu.style.border = `2px solid ${theme.border}`;
    menu.style.borderRadius = "10px";
    menu.style.padding = "10px";
    menu.style.fontFamily = "sans-serif";
