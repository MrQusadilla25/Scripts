    menu.style.zIndex = "999999";
    menu.style.position = "fixed";
    menu.style.top = "20px";
    menu.style.right = "20px";
  }

  function styleButton(btn) {
    const theme = themes[currentTheme];
    btn.style.width = "100%";
    btn.style.marginTop = "5px";
    btn.style.padding = "6px";
    btn.style.background = "#111";
    btn.style.color = theme.text;
    btn.style.border = `1px solid ${theme.border}`;
    btn.style.borderRadius = "5px";
    btn.style.cursor = "pointer";
    btn.onmouseenter = () => (btn.style.background = "#222");
    btn.onmouseleave = () => (btn.style.background = "#111");
  }

  // === Main Menu Logic ===
  function updateMenu() {
    header.textContent = `${MENU_TITLE} P${currentPage + 1} by ${AUTHOR}`;
    buttonContainer.innerHTML = "";
    descriptionBox.textContent = "";

    if (currentPage < totalPages - 1) {
      const start = currentPage * MODS_PER_PAGE;
      const modsOnPage = mods.slice(start, start + MODS_PER_PAGE);

      const backBtn = document.createElement("button");
      backBtn.textContent = "<<<<<<";
      backBtn.disabled = currentPage === 0;
      backBtn.onclick = () => {
        if (currentPage > 0) {
          currentPage--;
          updateMenu();
        }
      };
      styleButton(backBtn);
      buttonContainer.appendChild(backBtn);

      const forwardBtn = document.createElement("button");
      forwardBtn.textContent = ">>>>>>";
      forwardBtn.disabled = currentPage >= totalPages - 2;
      forwardBtn.onclick = () => {
        currentPage++;
        updateMenu();
      };
      styleButton(forwardBtn);
      buttonContainer.appendChild(forwardBtn);

      modsOnPage.forEach((mod) => {
        const btn = document.createElement("button");
        btn.textContent = mod.name;
        btn.onclick = () => {
          descriptionBox.textContent = mod.description;
          if (modScripts[mod.name]) modScripts[mod.name]();
        };
        styleButton(btn);
        buttonContainer.appendChild(btn);
      });

      if (currentPage === 1) {
        const settingsBtn = document.createElement("button");
        settingsBtn.textContent = "Open Settings";
        settingsBtn.onclick = () => {
          currentPage = totalPages - 1;
          updateMenu();
        };
        styleButton(settingsBtn);
        buttonContainer.appendChild(settingsBtn);
      }
    } else {
      const backBtn = document.createElement("button");
      backBtn.textContent = "<<<<<<";
      backBtn.onclick = () => {
        currentPage--;
        updateMenu();
      };
      styleButton(backBtn);
      buttonContainer.appendChild(backBtn);

      const themeLabel = document.createElement("div");
      themeLabel.textContent = "Theme Selector:";
      themeLabel.style = "margin-top: 5px; color: #aaa;";
      buttonContainer.appendChild(themeLabel);

      Object.keys(themes).forEach((themeName) => {
        const btn = document.createElement("button");
        btn.textContent = themeName;
        btn.onclick = () => {
          currentTheme = themeName;
          updateTheme();
          updateMenu();
        };
        styleButton(btn);
        buttonContainer.appendChild(btn);
      });

      const customThemeBtn = document.createElement("button");
      customThemeBtn.textContent = "Set Custom Theme";
      customThemeBtn.onclick = () => {
        const bg = prompt("Enter background color (e.g., #000000):");
        const text = prompt("Enter text color (e.g., #ffffff):");
        const border = prompt("Enter border color (e.g., #ffffff):");
        themes["custom"] = { bg, text, border };
        currentTheme = "custom";
        updateTheme();
        updateMenu();
      };
      styleButton(customThemeBtn);
      buttonContainer.appendChild(customThemeBtn);

      const shortcutBtn = document.createElement("button");
      shortcutBtn.textContent = "Set Toggle Shortcut";
      shortcutBtn.onclick = () => {
        const key = prompt("Enter a single character key to toggle the menu:");
        if (key) {
          toggleKey = key.toLowerCase();
          alert(`Toggle key set to '${toggleKey}'`);
        }
      };
      styleButton(shortcutBtn);
      buttonContainer.appendChild(shortcutBtn);

      const exportBtn = document.createElement("button");
      exportBtn.textContent = "Export Settings";
      exportBtn.onclick = () => {
        const settings = {
          theme: currentTheme,
          toggleKey: toggleKey,
        };
        const blob = new Blob([JSON.stringify(settings)], { type: "application/json" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        a.href = url;
        a.download = "prodigySimSettings.json";
        a.click();
        URL.revokeObjectURL(url);
      };
      styleButton(exportBtn);
      buttonContainer.appendChild(exportBtn);

      const importBtn = document.createElement("button");
      importBtn.textContent = "Import Settings";
      importBtn.onclick = () => {
        const input = document.createElement("input");
        input.type = "file";
        input.accept = ".json";
        input.onchange = (e) => {
          const file = e.target.files[0];
          const reader = new FileReader();
          reader.onload = (event) => {
            try {
              const settings = JSON.parse(event.target.result);
              if (settings.theme && themes[settings.theme]) {
                currentTheme = settings.theme;
              }
              if (settings.toggleKey) {
                toggleKey = settings.toggleKey;
              }
              updateTheme();
              updateMenu();
            } catch (err) {
              alert("Invalid settings file.");
            }
          };
          reader.readAsText(file);
        };
        input.click();
      };
      styleButton(importBtn);
      buttonContainer.appendChild(importBtn);
    }

    updateTheme();
  }

  document.addEventListener("keydown", (e) => {
    if (toggleKey && e.key.toLowerCase() === toggleKey) {
      menu.style.display = menu.style.display === "none" ? "block" : "none";
    }
  });

  // === Rainbow Animation Keyframes ===
  const style = document.createElement("style");
  style.textContent = `
    @keyframes rainbow {
      0% { background-position: 0% 50%; }
      50% { background-position: 100% 50%; }
      100% { background-position: 0% 50%; }
    }
  `;
  document.head.appendChild(style);

  updateMenu();
})();
